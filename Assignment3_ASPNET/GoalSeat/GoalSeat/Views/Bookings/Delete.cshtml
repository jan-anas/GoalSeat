@model GoalSeat.Models.Booking

@{
    ViewData["Title"] = "Delete Booking";
}

<div class="box">

    <h2>Delete Booking</h2>

    <p>
        Are you sure you want to delete this booking?
    </p>

    <table class="matches-table">
        <tr>
            <th>Customer Name</th>
            <td>@Model.CustomerName</td>
        </tr>
        <tr>
            <th>Email</th>
            <td>@Model.CustomerEmail</td>
        </tr>
        <tr>
            <th>Match</th>
            <td>@Model.MatchName</td>
        </tr>
        <tr>
            <th>Ticket Type</th>
            <td>@Model.TicketType</td>
        </tr>
        <tr>
            <th>Tickets</th>
            <td>@Model.TicketCount</td>
        </tr>
        <tr>
            <th>Total Price</th>
            <td>@Model.TotalPrice.ToString("0.00") SAR</td>
        </tr>
    </table>

    <form asp-controller="Bookings" asp-action="Delete" method="post">

        <input type="hidden" asp-for="Id" />

        <input type="submit" value="Confirm Delete" />

        <br /><br />

        <a asp-controller="Bookings"
           asp-action="Index"
           class="match-button">
            Cancel
        </a>

    </form>

</div>